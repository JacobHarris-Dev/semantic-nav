# Copy to .env and fill in your values ( .env is gitignored )



# Required for online mode (query rewrite + reranking)

GROQ_API_KEY=



# offline (default) or online

SN_MODE=offline



# Query splitter (online mode only): groq | gemini | cerebras

SN_QUERY_SPLITTER=groq

# SN_QUERY_SPLITTER_MODEL=



# Provider API keys (only the selected SN_QUERY_SPLITTER provider is required)

# GEMINI_API_KEY=

# CEREBRAS_API_KEY=



# Developer chunk debug dumps (cache/debug/)
# Writes *.chunks.txt on load and *.clusters.txt on first /outline build

SN_DEBUG_CHUNKS=false



# Optional overrides

# Max hits returned per subquery when a query is split (online mode); defaults to k
# SN_SUBQUERY_MAX_RESULTS=5

# Confidence threshold for all subqueries when a query is split; defaults to confidence_threshold
# SN_SUBQUERY_CONFIDENCE_THRESHOLD=30

# Document outline defaults for GET /outline
# SN_OUTLINE_BRANCH_FACTOR=10
# SN_OUTLINE_MAX_DEPTH=3
# SN_OUTLINE_MAX_SECTIONS=8
# SN_OUTLINE_MIN_SECTION_CHUNKS=2
# Max LLM-generated labels per outline build in online mode (legacy cap for subsection titles)
# SN_OUTLINE_LLM_MAX_NODES=25

# SN_MODEL_NAME=all-MiniLM-L6-v2

# SN_MODEL_CACHE_DIR=models

# SN_ALLOW_DOWNLOAD=false

# SN_DEBUG_CHUNKS_DIR=cache/debug

# Comma-separated browser origins allowed to call the API (Vite dev server by default)
# SN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

