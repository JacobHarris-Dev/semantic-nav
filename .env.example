# Copy to .env and fill in your values ( .env is gitignored )

# Required for online mode (query rewrite + reranking)
GROQ_API_KEY=

# offline (default) or online
SN_MODE=online

# Developer chunk debug dumps (cache/debug/)
SN_DEBUG_CHUNKS=false

# Optional overrides
# SN_MODEL_NAME=all-MiniLM-L6-v2
# SN_MODEL_CACHE_DIR=models
# SN_ALLOW_DOWNLOAD=false
# SN_DEBUG_CHUNKS_DIR=cache/debug
